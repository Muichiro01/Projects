class Book:
    def __init__(self,title,author):
        self.title=title
        self.author=author
        self.is_borrowed=False

    def borrow(self):
        self.is_borrowed=True
        print(self.title, "has been borrowed")

    def return_book(self):
        self.is_borrowed=False
        print(self.is_borrowed,"has been returned")

book1=Book("Hunger Games","Suzanne Collins")
